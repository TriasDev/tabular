<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\TriasDev.Tabular\TriasDev.Tabular.csproj" />
  </ItemGroup>

  <!-- Validation only: the writer's output is checked against the OOXML schema. The library itself takes no package. -->
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <!-- Embedded rather than copied, so a test finds its file wherever the assembly runs. -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures\Producers\*" Exclude="Fixtures\Producers\*.md" LogicalName="Producers/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
