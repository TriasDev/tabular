<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- The two LTS releases. net8 is where many consumers still are; net10 is where the performance
       numbers are measured. Benchmarks and samples stay on net10 alone. -->
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Held at zero warnings. A newly published advisory stays a warning, so it cannot break a build
       nobody changed. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- What every test project runs on. -->

  <PropertyGroup>
    <XunitV3Version>4.0.1</XunitV3Version>
    <!-- A test project is an executable under Microsoft.Testing.Platform. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Microsoft.Testing.Platform: xunit v3 builds each test project into an executable that `dotnet
       test` runs directly (global.json opts in). Coverage comes from coverlet's platform extension,
       which writes both the opencover report SonarQube reads and the cobertura one Codecov does. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="$(XunitV3Version)" />
    <PackageReference Include="coverlet.MTP" Version="10.0.1" />
  </ItemGroup>

</Project>
