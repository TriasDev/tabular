<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- The two LTS releases. net8 is where many consumers still are; net10 is where the performance
       numbers are measured. Benchmarks and samples stay on net10 alone. -->
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Held at zero warnings. A newly published advisory stays a warning, so it cannot break a build
       nobody changed. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- What every shipped package carries. -->

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>TriasDev GmbH &amp; Co. KG</Authors>
    <Company>TriasDev GmbH &amp; Co. KG</Company>
    <Copyright>Copyright © 2026 TriasDev GmbH &amp; Co. KG</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://triasdev.github.io/tabular/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TriasDev/tabular</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <!-- Debuggable from the package: sources linked to the commit (SourceLink is part of the SDK), symbols
       in a .snupkg beside it, and a build that is byte-for-byte repeatable in CI. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- The public API is frozen in PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt: adding, changing or
       removing a public member without recording it fails the build (RS0016/RS0017). Package
       validation checks the targets agree with each other, and — once a version ships — against it. -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- The last published version; bump it after each release. -->
    <PackageValidationBaselineVersion>0.1.0</PackageValidationBaselineVersion>
    <!-- RS0026/RS0027 are overload-design advice. The overloads that trip them are deliberate: a
         cancellation token last and optional, beside an overload that takes progress. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../assets/icon-128.png" Pack="true" PackagePath="icon.png" Visible="false" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" Condition="Exists('PublicAPI.Shipped.txt')" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" Condition="Exists('PublicAPI.Unshipped.txt')" />
  </ItemGroup>

</Project>
