<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);CS8600</WarningsAsErrors>
    <PackageId>TriasDev.Tabular</PackageId>
    <Description>Fast, low-memory reading of large Excel (.xlsx) and CSV files, with no dependencies — and a safe import pipeline on top: profile every column over every row, map columns to your fields, validate, and get typed rows or errors that name their row and column. Detects csv encoding and delimiter, repairs malformed quoting, bounds hostile input.</Description>
    <PackageTags>csv;excel;xlsx;spreadsheet;import;parser;reader;streaming;data-import;schema-mapping;validation;profiling</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The profiler, the distinct budget and the hypothesis builder are internal, and their tests
         are worth keeping at that level. -->
    <InternalsVisibleTo Include="TriasDev.Tabular.Tests" />
  </ItemGroup>

</Project>
