<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);CS8600</WarningsAsErrors>
    <!-- No reflection, no dynamic code: safe to trim and to compile ahead of time. The trim and AOT
         analyzers hold it to that, and the package says so to consumers. -->
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>TriasDev.Tabular</PackageId>
    <Description>Fast, low-memory reading and writing of csv, Excel (.xlsx) and OpenDocument (.ods) files, with no dependencies. Read: profile every column over every row, map columns to your fields, validate, and import typed rows or errors that name their row and column; detects csv encoding and delimiter, repairs malformed quoting, reads zip, tar and gzip archives, bounds hostile input. Write: csv, xlsx, ods and a zip of csv sheets, streamed asynchronously into any stream in flat memory, with typed columns, cell styles, frozen headers and auto-filters; a value a format cannot hold exactly is refused, never rounded.</Description>
    <PackageTags>csv;excel;xlsx;ods;opendocument;libreoffice;spreadsheet;import;export;parser;reader;writer;streaming;async;data-import;data-export;schema-mapping;validation;profiling;styles;zip</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The profiler, the distinct budget and the hypothesis builder are internal, and their tests
         are worth keeping at that level. -->
    <InternalsVisibleTo Include="TriasDev.Tabular.Tests" />
  </ItemGroup>

</Project>
