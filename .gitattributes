# https://help.github.com/en/articles/dealing-with-line-endings
# "text=auto" converts line endings to LF when checking in to the repository.
# "eol=crlf" converts line endings to CR/LF when checking out to the local machine.
* text=auto eol=lf
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf

# Producer fixtures are read byte for byte: no line-ending conversion.
tests/TriasDev.Tabular.Tests/Fixtures/Producers/* -text
tests/TriasDev.Tabular.Tests/Fixtures/Producers/*.md text
