<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- The only project that references other parsing libraries. The library itself takes none, and
       TabularIndependenceTests checks that against its resolved graph; nothing here reaches it. -->
  <ItemGroup>
    <!-- csv -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Sep" Version="0.17.1" />
    <PackageReference Include="Sylvan.Data.Csv" Version="1.4.4" />
    <!-- xlsx -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- The last LGPL release. From 5.0 EPPlus is under the Polyform Noncommercial licence. -->
    <PackageReference Include="EPPlus" Version="4.5.3.3" />
    <!-- EPPlus 4.5.3.3 brings 4.7.0, which carries a known critical vulnerability. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="MiniExcel" Version="1.46.0" />
    <!-- Pinned below 2.8.0: from there the NuGet binary ships under a maintenance-fee agreement
         rather than Apache-2.0. -->
    <PackageReference Include="NPOI" Version="2.7.6" />
    <!-- NPOI 2.7.6 brings 8.0.2, which carries a known high-severity vulnerability. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <PackageReference Include="Sylvan.Data.Excel" Version="0.5.8" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TriasDev.Tabular\TriasDev.Tabular.csproj" />
  </ItemGroup>

</Project>
