<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- The third-party writers are referenced here and nowhere else: the library takes no dependency,
       and TabularIndependenceTests checks that against its resolved graph. -->

  <ItemGroup>
    <!-- csv -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Sep" Version="0.17.1" />
    <PackageReference Include="Sylvan.Data.Csv" Version="1.4.4" />
    <!-- xlsx -->
    <PackageReference Include="LargeXlsx" Version="2.0.2" />
    <PackageReference Include="SpreadCheetah" Version="1.28.0" />
    <PackageReference Include="MiniExcel" Version="1.46.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TriasDev.Tabular\TriasDev.Tabular.csproj" />
  </ItemGroup>

</Project>
